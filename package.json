{
  "name": "dsh-task-progress-tray",
  "version": "0.1.0",
  "private": true,
  "description": "Bottom-right live task-progress tray: todo list, background jobs, goal phase, token usage, and DeepSeek peak/off-peak pricing for the current session",
  "type": "module",
  "main": "assets/tray-plugin/lib/index.js",
  "exports": {
    ".": {
      "default": "./assets/tray-plugin/lib/index.js"
    },
    "./client": {
      "default": "./assets/tray-plugin/lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
